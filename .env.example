PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pdfflow

# Optional: if you wire up a cloud conversion provider for PDF<->Word/Excel
# (e.g. CloudConvert, Adobe PDF Services, ConvertAPI) put its key here.
CONVERSION_API_KEY=

# Required on the server for real password protect/unlock (qpdf CLI).
# Install with: apt-get install qpdf  (Linux)  |  brew install qpdf  (Mac)
QPDF_PATH=qpdf
